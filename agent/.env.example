# 复制本文件为 .env 后填写（.env 已在 .gitignore 中，不会提交）
# 说明：这里的 Key 只存在你自己的电脑/服务器上，App 端不需要知道它。

# 与 App 里「大模型识别」用同一套 OpenAI 兼容参数即可
# DeepSeek 示例：AGENT_BASE_URL=https://api.deepseek.com/v1 / AGENT_MODEL=deepseek-flash
# （V4.1-Flash 的 API 名称是 deepseek-flash；旧的 deepseek-chat 已下线）
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_API_KEY=sk-你的Key
AGENT_MODEL=gpt-4o-mini

# 视觉模型（可选）：用户允许上传图片、要求"只保留画圈的单词"时用
AGENT_VISION_MODEL=gpt-4o

# 离线自测：不填 Key、把下面设为 1，用规则模拟"模型理解"，整张图仍可跑通
AGENT_MOCK=0

# 监听
AGENT_HOST=0.0.0.0
AGENT_PORT=8787
